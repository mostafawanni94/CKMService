# =============================================================================
# CKM SERVICES - ENVIRONMENT CONFIGURATION
# Copy to .env and fill in. .env is gitignored.
# =============================================================================

# Django core
# DEBUG defaults to False. Set it to True only for local development.
DEBUG=True
# Required whenever DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Comma separated. Required when DEBUG=False; '*' is rejected when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# =============================================================================
# DATABASE
# =============================================================================
# sqlite (development) or postgresql (production)
DATABASE_ENGINE=sqlite

POSTGRES_DB=ckmservices
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# CORS / CSRF
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required when DEBUG=False and the dashboard is on another origin.
CSRF_TRUSTED_ORIGINS=

# =============================================================================
# FIELD-LEVEL ENCRYPTION
# =============================================================================
# Comma-separated Fernet keys; the first encrypts, all of them decrypt.
# Generate with:  python manage.py generate_encryption_key
# Required when DEBUG=False. See ENCRYPTION.md.
#
# BACK THIS UP SEPARATELY FROM THE DATABASE. A dump restored without this key
# cannot decrypt BSN, IBAN or document numbers.
FIELD_ENCRYPTION_KEYS=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Short-lived access tokens; every client refreshes automatically.
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# =============================================================================
# HTTPS (applied only when DEBUG=False)
# =============================================================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# =============================================================================
# EMAIL (notifications, password reset)
# Sender address and app password are configured at runtime in
# /dashboard/settings, not here. Set the public dashboard URL there too so
# password-reset links resolve.
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# =============================================================================
# LOGGING
# =============================================================================
DJANGO_LOG_LEVEL=INFO

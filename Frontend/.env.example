# Copy to .env.local for development. .env* files are gitignored.

# Where the Next.js dev/prod server proxies /api and /media.
# Server-side only — not exposed to the browser.
BACKEND_API_URL=http://localhost:8000

# Leave unset to use the same-origin /api proxy above, which is the
# recommended setup. Set it only when the browser must call the API directly
# on another origin (which then needs CORS_ALLOWED_ORIGINS on the backend).
# NEXT_PUBLIC_API_URL=/api
